{
  "name": "@simonpai.play/monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/commons",
    "packages/axiom",
    "packages/prng",
    "packages/arithmetic",
    "packages/game",
    "site"
  ],
  "scripts": {
    "autoplay": "npm run autoplay --workspace=packages/game",
    "start:autoplay": "npm run autoplay --workspace=site",
    "start": "npm run start --workspace=site",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "dotenv": "^16.0.0",
    "eslint": "^9.17.0",
    "npm-run-all": "^4.1.5",
    "rimraf": "^4.0.4",
    "uvu": "^0.5.6"
  }
}
